# Copiar este archivo como .env y completar los valores.
# El archivo .env NO debe versionarse.

# --- PostgreSQL ---
POSTGRES_DB=citas_municipales
POSTGRES_USER=citas_app
POSTGRES_PASSWORD=cambiar-por-clave-local-segura

# --- Backend ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-secreto-local
ENTORNO=desarrollo
MAX_DOCUMENTO_MB=10

# --- Frontend ---
VITE_API_URL=http://localhost:8000
