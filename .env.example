# Copiar este archivo como .env y completar los valores.
# El archivo .env NO debe versionarse.

# --- PostgreSQL ---
POSTGRES_DB=citas_municipales
POSTGRES_USER=citas_app
POSTGRES_PASSWORD=cambiar-por-clave-local-segura
# Opcional: si se define, el backend usa esta base en lugar de la local.
# Se aceptan los esquemas postgresql://, postgres:// y postgresql+psycopg://.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# --- Backend ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-secreto-local
ENTORNO=desarrollo
# Vigencia del token de acceso en minutos (sin refresh token en el MVP).
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_DOCUMENTO_MB=10

# --- Frontend ---
VITE_API_URL=http://localhost:8000
# Hosts permitidos por Vite, separados por coma (solo necesario al publicar).
# VITE_ALLOWED_HOSTS=aplicacion-discapacidad.onrender.com

# --- Backend (CORS) ---
# Orígenes permitidos, en formato JSON.
# CORS_ORIGINS=["https://aplicacion-discapacidad.onrender.com"]
